# Copy to .env (in the folder you run `dgro` from) and fill in what you need.
# With nothing set, dgro runs in demo mode: simulated AI, sandbox email.

# --- Claude ------------------------------------------------------------------------------------
# https://console.anthropic.com/settings/keys  (web search must be enabled for your org)
ANTHROPIC_API_KEY=
# DGRO_MODEL=claude-opus-5
# DGRO_LLM=auto                 # auto | anthropic | fake (offline demo)
# DGRO_MAX_VENDORS=8            # vendors per web search
# DGRO_WEB_SEARCH_MAX_USES=6    # searches per vendor search ($10 per 1,000 searches + tokens)

# --- You (used to sign quote requests) --------------------------------------------------------
DGRO_REQUESTER_NAME=
DGRO_REQUESTER_EMAIL=
DGRO_REQUESTER_PHONE=
# DGRO_REQUESTER_COMPANY=

# --- Email ---------------------------------------------------------------------------------------
# sandbox: nothing is sent, emails are saved to data/outbox and you paste vendor replies in the UI.
# smtp: real sending (SMTP) and automatic reply collection (IMAP).
DGRO_EMAIL_MODE=sandbox
# Gmail: enable 2-Step Verification, create an app password (https://myaccount.google.com/apppasswords).
# DGRO_SMTP_HOST=smtp.gmail.com
# DGRO_SMTP_PORT=587
# DGRO_SMTP_SECURITY=starttls   # starttls | ssl | none
# DGRO_SMTP_USERNAME=you@gmail.com
# DGRO_SMTP_PASSWORD=your-16-char-app-password
# DGRO_IMAP_HOST=imap.gmail.com
# DGRO_IMAP_PORT=993
# DGRO_IMAP_FOLDER=INBOX        # IMAP login defaults to the SMTP username/password
# DGRO_EMAIL_FROM=              # defaults to DGRO_SMTP_USERNAME
# DGRO_INBOX_POLL_SECONDS=180
# Safe live test: every outgoing email goes to this address instead of the vendor.
# DGRO_EMAIL_REDIRECT_TO=you+dgro-test@gmail.com

# --- Server ------------------------------------------------------------------------------------
# DGRO_HOST=127.0.0.1           # there is no login: keep it on localhost
# DGRO_PORT=8000
# DGRO_DATA_DIR=data
# DGRO_WORKERS=2
# DGRO_LOG_LEVEL=INFO
